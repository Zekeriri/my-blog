---
import { formatDate } from '../utils/post';

interface Props {
  pubDate: Date;
  category?: string;
}

const { pubDate, category } = Astro.props;
---

<div class="meta">
  <span>
    发布 <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
  </span>
  {category && (
    <>
      {' · '}
      <a
        class="category"
        href={`${import.meta.env.BASE_URL}categories/${encodeURIComponent(category)}/`}
      >
        {category}
      </a>
    </>
  )}
</div>
