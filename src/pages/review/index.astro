---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getReviewLogPost, parseReviewLog } from '../../utils/review';

const posts = await getCollection('blog');
const base = import.meta.env.BASE_URL;

const logPost = getReviewLogPost(posts);
const records = logPost ? parseReviewLog(logPost.body ?? '') : [];
const logHref = logPost ? `${base}blog/${logPost.id}/` : undefined;
---

<BaseLayout title="复盘" description="根据复盘文档显示每日回顾">
  <h1>复盘</h1>
  <p class="meta" id="review-day-meta">加载中…</p>
  {logHref ? (
    <p class="meta">
      数据来自 <a href={logHref}>复盘</a>
      （在 Obsidian 里编辑该文档后提交即可更新）
    </p>
  ) : (
    <p class="meta">未找到 `个人记录/复盘.md`，请先创建该文档。</p>
  )}

  <section
    class="card review-today"
    id="review-app"
    data-records={JSON.stringify(records)}
  >
    <h2>今日</h2>
    <div id="review-today-body" class="review-body">
      <p class="meta">加载中…</p>
    </div>
  </section>

  <section class="card">
    <h2>复盘热力图</h2>
    <div class="practice-heatmap-wrap">
      <div class="practice-heatmap" id="review-heatmap" aria-label="近一年复盘热力图"></div>
    </div>
    <div class="practice-heatmap-legend">
      <span>无</span>
      <span class="practice-cell level-0"></span>
      <span class="practice-cell level-4"></span>
      <span>有</span>
    </div>
    <p class="meta">有写复盘的日子会点亮。</p>
  </section>

  <section class="card">
    <h2>以往复盘</h2>
    <div id="review-history" class="review-history">
      <p class="meta">暂无记录</p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var DAY_START_HOUR = 5;
    var WEEKS = 53;
    var app = document.getElementById('review-app');
    if (!app) return;

    var RECORDS = [];
    try {
      RECORDS = JSON.parse(app.getAttribute('data-records') || '[]');
    } catch (e) {}

    var recordMap = {};
    RECORDS.forEach(function (rec) {
      recordMap[rec.date] = rec;
    });

    function pad(n) {
      return n < 10 ? '0' + n : String(n);
    }

    function getPracticeDate(now) {
      var d = new Date(now.getTime());
      if (d.getHours() < DAY_START_HOUR) {
        d.setDate(d.getDate() - 1);
      }
      return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
    }

    function formatDisplayDate(key) {
      var parts = key.split('-');
      return parts[0] + '年' + Number(parts[1]) + '月' + Number(parts[2]) + '日';
    }

    function findDay(key) {
      return recordMap[key] || null;
    }

    function dateKeyFromDate(d) {
      return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
    }

    function parseKey(key) {
      return new Date(key + 'T12:00:00');
    }

    function escapeHtml(text) {
      return String(text)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function noteToHtml(note) {
      return escapeHtml(note)
        .split(/\n+/)
        .filter(Boolean)
        .map(function (line) {
          return '<p>' + line + '</p>';
        })
        .join('');
    }

    function renderHeatmap(todayKey) {
      var heatmap = document.getElementById('review-heatmap');
      if (!heatmap) return;

      var today = parseKey(todayKey);
      var lastSaturday = new Date(today.getTime());
      lastSaturday.setDate(lastSaturday.getDate() + (6 - lastSaturday.getDay()));
      var firstSunday = new Date(lastSaturday.getTime());
      firstSunday.setDate(firstSunday.getDate() - (WEEKS * 7 - 1));

      var monthByWeek = [];
      var cells = [];
      var cursor = new Date(firstSunday.getTime());
      var lastMonth = -1;

      for (var w = 0; w < WEEKS; w++) {
        var weekCells = [];
        var weekMonthLabel = '';
        for (var dow = 0; dow < 7; dow++) {
          var key = dateKeyFromDate(cursor);
          var day = findDay(key);
          var has = !!(day && day.note);
          var future = cursor > today;
          var level = future ? -1 : has ? 4 : 0;
          var title =
            formatDisplayDate(key) +
            (future ? '' : has ? ' · 已复盘' : ' · 未写');

          var m = cursor.getMonth();
          if (m !== lastMonth) {
            weekMonthLabel = m + 1 + '月';
            lastMonth = m;
          }

          weekCells.push({ level: level, title: title });
          cursor.setDate(cursor.getDate() + 1);
        }
        monthByWeek.push(weekMonthLabel);
        cells.push(weekCells);
      }

      var monthsHtml =
        '<div class="practice-heatmap-months">' +
        '<span class="practice-heatmap-dow-spacer"></span>' +
        monthByWeek
          .map(function (label) {
            return '<span>' + label + '</span>';
          })
          .join('') +
        '</div>';

      var dowLabels = ['日', '一', '二', '三', '四', '五', '六'];
      var bodyHtml =
        '<div class="practice-heatmap-body">' +
        '<div class="practice-heatmap-dows">' +
        dowLabels
          .map(function (label, i) {
            return i % 2 === 1
              ? '<span>' + label + '</span>'
              : '<span class="is-hidden">' + label + '</span>';
          })
          .join('') +
        '</div>' +
        '<div class="practice-heatmap-weeks">' +
        cells
          .map(function (week) {
            return (
              '<div class="practice-heatmap-week">' +
              week
                .map(function (cell) {
                  if (cell.level < 0) {
                    return (
                      '<span class="practice-cell is-future" title="' +
                      cell.title +
                      '"></span>'
                    );
                  }
                  return (
                    '<span class="practice-cell level-' +
                    cell.level +
                    '" title="' +
                    cell.title +
                    '"></span>'
                  );
                })
                .join('') +
              '</div>'
            );
          })
          .join('') +
        '</div></div>';

      heatmap.innerHTML = monthsHtml + bodyHtml;
    }

    function render() {
      var todayKey = getPracticeDate(new Date());
      var day = findDay(todayKey);

      var meta = document.getElementById('review-day-meta');
      if (meta) {
        meta.textContent =
          '复盘日：' +
          formatDisplayDate(todayKey) +
          '（每天凌晨 5 点换日）';
      }

      var todayBody = document.getElementById('review-today-body');
      if (todayBody) {
        if (day && day.note) {
          todayBody.innerHTML = noteToHtml(day.note);
        } else {
          todayBody.innerHTML =
            '<p class="meta">今天还没写：在「复盘」文档里加上今天的日期和内容。</p>';
        }
      }

      renderHeatmap(todayKey);

      var history = document.getElementById('review-history');
      if (!history) return;

      var list = RECORDS.filter(function (rec) {
        return rec.date !== todayKey;
      });

      if (list.length === 0) {
        history.innerHTML = '<p class="meta">暂无以往记录</p>';
        return;
      }

      history.innerHTML = list
        .map(function (rec) {
          return (
            '<article class="review-hist-row">' +
            '<h3>' +
            formatDisplayDate(rec.date) +
            '</h3>' +
            '<div class="review-body">' +
            noteToHtml(rec.note || '') +
            '</div>' +
            '</article>'
          );
        })
        .join('');
    }

    render();
  })();
</script>
