---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  TRAINING_IDS,
  getPracticeLogPost,
  parsePracticeLog,
} from '../../utils/practice';

const posts = await getCollection('blog');
const base = import.meta.env.BASE_URL;

function findPostHref(namePart: string) {
  const post = posts.find(
    (p) =>
      p.data.category === '声乐' &&
      !p.filePath?.endsWith('练习打卡.md') &&
      (p.id.includes(namePart) || p.filePath?.includes(namePart))
  );
  return post ? `${base}blog/${post.id}/` : undefined;
}

const trainings = TRAINING_IDS.map((id) => ({
  id,
  label: id,
  href: findPostHref(id === '音准' ? '音准' : id),
}));

const logPost = getPracticeLogPost(posts);
const records = logPost ? parsePracticeLog(logPost.body ?? '') : [];
const logHref = logPost ? `${base}blog/${logPost.id}/` : undefined;
---

<BaseLayout title="今日练习" description="根据练习打卡文档显示声乐每日进度">
  <h1>今日练习</h1>
  <p class="meta" id="practice-day-meta">加载中…</p>
  {logHref ? (
    <p class="meta">
      数据来自 <a href={logHref}>练习打卡</a>
      （在 Obsidian 里编辑该文档后提交即可更新）
    </p>
  ) : (
    <p class="meta">未找到 `声乐/练习打卡.md`，请先创建该文档。</p>
  )}

  <section
    class="card practice-today"
    id="practice-app"
    data-ids={JSON.stringify([...TRAINING_IDS])}
    data-records={JSON.stringify(records)}
  >
    <div class="practice-summary">
      <span id="practice-progress">0 / 4</span>
      <span class="meta" id="practice-streak" style="margin:0;"></span>
    </div>
    <ul class="practice-list" id="practice-list">
      {trainings.map((item) => (
        <li>
          <div class="practice-check" data-id={item.id} aria-pressed="false">
            <span class="practice-box" aria-hidden="true"></span>
            <span class="practice-label">{item.label}</span>
          </div>
          {item.href && (
            <a class="practice-note" href={item.href}>笔记</a>
          )}
        </li>
      ))}
    </ul>
    <p class="meta practice-hint" id="practice-today-note"></p>
  </section>

  <section class="card">
    <h2>练习热力图</h2>
    <div class="practice-stats" id="practice-stats"></div>
    <div class="practice-heatmap-wrap">
      <div class="practice-heatmap" id="practice-heatmap" aria-label="近一年练习热力图"></div>
    </div>
    <div class="practice-heatmap-legend">
      <span>少</span>
      <span class="practice-cell level-0"></span>
      <span class="practice-cell level-1"></span>
      <span class="practice-cell level-2"></span>
      <span class="practice-cell level-3"></span>
      <span class="practice-cell level-4"></span>
      <span>多</span>
    </div>
    <p class="meta" id="practice-heatmap-tip">颜色越深，当天完成的训练项越多（最多 4 项）。</p>
  </section>

  <section class="card">
    <h2>最近记录</h2>
    <div id="practice-history" class="practice-history">
      <p class="meta">暂无记录</p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var DAY_START_HOUR = 5;
    var WEEKS = 53;
    var app = document.getElementById('practice-app');
    if (!app) return;

    var IDS = [];
    var RECORDS = [];
    try {
      IDS = JSON.parse(app.getAttribute('data-ids') || '[]');
      RECORDS = JSON.parse(app.getAttribute('data-records') || '[]');
    } catch (e) {}

    var recordMap = {};
    RECORDS.forEach(function (rec) {
      recordMap[rec.date] = rec;
    });

    function pad(n) {
      return n < 10 ? '0' + n : String(n);
    }

    function getPracticeDate(now) {
      var d = new Date(now.getTime());
      if (d.getHours() < DAY_START_HOUR) {
        d.setDate(d.getDate() - 1);
      }
      return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
    }

    function formatDisplayDate(key) {
      var parts = key.split('-');
      return parts[0] + '年' + Number(parts[1]) + '月' + Number(parts[2]) + '日';
    }

    function findDay(key) {
      return recordMap[key] || null;
    }

    function dateKeyFromDate(d) {
      return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
    }

    function parseKey(key) {
      return new Date(key + 'T12:00:00');
    }

    function calcStreak(todayKey, requireFull) {
      var streak = 0;
      var d = parseKey(todayKey);
      for (var i = 0; i < 400; i++) {
        var key = dateKeyFromDate(d);
        var day = findDay(key);
        var done = day && day.done ? day.done : [];
        var ok = requireFull
          ? IDS.every(function (id) {
              return done.indexOf(id) !== -1;
            })
          : done.length > 0;
        if (!ok) break;
        streak += 1;
        d.setDate(d.getDate() - 1);
      }
      return streak;
    }

    function calcLongestStreak(requireFull) {
      var best = 0;
      var current = 0;
      var keys = Object.keys(recordMap).sort();
      if (keys.length === 0) return 0;

      var start = parseKey(keys[0]);
      var end = parseKey(keys[keys.length - 1]);
      for (var d = new Date(start.getTime()); d <= end; d.setDate(d.getDate() + 1)) {
        var key = dateKeyFromDate(d);
        var day = findDay(key);
        var done = day && day.done ? day.done : [];
        var ok = requireFull
          ? IDS.every(function (id) {
              return done.indexOf(id) !== -1;
            })
          : done.length > 0;
        if (ok) {
          current += 1;
          if (current > best) best = current;
        } else {
          current = 0;
        }
      }
      return best;
    }

    function notePreview(note, done) {
      if (!note) return '';
      var text = note;
      done.forEach(function (id) {
        text = text.split(id).join(' ');
      });
      text = text
        .replace(/[,，、/|]+/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
      return text;
    }

    function levelForCount(n) {
      if (!n) return 0;
      if (n >= 4) return 4;
      return n;
    }

    function renderHeatmap(todayKey) {
      var heatmap = document.getElementById('practice-heatmap');
      var stats = document.getElementById('practice-stats');
      if (!heatmap) return;

      var today = parseKey(todayKey);
      // GitHub 风格：每列周日→周六；最后一列含本周六
      var lastSaturday = new Date(today.getTime());
      lastSaturday.setDate(lastSaturday.getDate() + (6 - lastSaturday.getDay()));
      var firstSunday = new Date(lastSaturday.getTime());
      firstSunday.setDate(firstSunday.getDate() - (WEEKS * 7 - 1));

      var monthByWeek = [];
      var cells = [];
      var cursor = new Date(firstSunday.getTime());
      var lastMonth = -1;

      for (var w = 0; w < WEEKS; w++) {
        var weekCells = [];
        var weekMonthLabel = '';
        for (var dow = 0; dow < 7; dow++) {
          var key = dateKeyFromDate(cursor);
          var day = findDay(key);
          var count = day && day.done ? day.done.length : 0;
          var future = cursor > today;
          var level = future ? -1 : levelForCount(count);
          var title =
            formatDisplayDate(key) +
            (future
              ? ''
              : count
                ? ' · 完成 ' + count + '/' + IDS.length + '：' + day.done.join('、')
                : ' · 未练习');

          var m = cursor.getMonth();
          if (m !== lastMonth) {
            weekMonthLabel = m + 1 + '月';
            lastMonth = m;
          }

          weekCells.push({
            key: key,
            level: level,
            title: title,
          });
          cursor.setDate(cursor.getDate() + 1);
        }
        monthByWeek.push(weekMonthLabel);
        cells.push(weekCells);
      }

      var monthsHtml =
        '<div class="practice-heatmap-months">' +
        '<span class="practice-heatmap-dow-spacer"></span>' +
        monthByWeek.map(function (label) {
          return '<span>' + label + '</span>';
        }).join('') +
        '</div>';

      var dowLabels = ['日', '一', '二', '三', '四', '五', '六'];
      var bodyHtml =
        '<div class="practice-heatmap-body">' +
        '<div class="practice-heatmap-dows">' +
        dowLabels
          .map(function (label, i) {
            return i % 2 === 1
              ? '<span>' + label + '</span>'
              : '<span class="is-hidden">' + label + '</span>';
          })
          .join('') +
        '</div>' +
        '<div class="practice-heatmap-weeks">' +
        cells
          .map(function (week) {
            return (
              '<div class="practice-heatmap-week">' +
              week
                .map(function (cell) {
                  if (cell.level < 0) {
                    return '<span class="practice-cell is-future" title="' + cell.title + '"></span>';
                  }
                  return (
                    '<span class="practice-cell level-' +
                    cell.level +
                    '" title="' +
                    cell.title +
                    '"></span>'
                  );
                })
                .join('') +
              '</div>'
            );
          })
          .join('') +
        '</div></div>';

      heatmap.innerHTML = monthsHtml + bodyHtml;

      if (stats) {
        var practicedDays = RECORDS.filter(function (r) {
          return r.done && r.done.length > 0;
        }).length;
        var totalItems = RECORDS.reduce(function (sum, r) {
          return sum + (r.done ? r.done.length : 0);
        }, 0);
        var fullDays = RECORDS.filter(function (r) {
          return (
            r.done &&
            IDS.every(function (id) {
              return r.done.indexOf(id) !== -1;
            })
          );
        }).length;
        var longestAny = calcLongestStreak(false);
        var longestFull = calcLongestStreak(true);
        var currentAny = calcStreak(todayKey, false);

        stats.innerHTML =
          '<div class="practice-stat"><strong>' +
          practicedDays +
          '</strong><span>累计练习天</span></div>' +
          '<div class="practice-stat"><strong>' +
          totalItems +
          '</strong><span>累计训练项</span></div>' +
          '<div class="practice-stat"><strong>' +
          fullDays +
          '</strong><span>全勤天</span></div>' +
          '<div class="practice-stat"><strong>' +
          currentAny +
          '</strong><span>当前连续</span></div>' +
          '<div class="practice-stat"><strong>' +
          longestAny +
          '</strong><span>最长连续</span></div>' +
          '<div class="practice-stat"><strong>' +
          longestFull +
          '</strong><span>最长全勤</span></div>';
      }
    }

    function render() {
      var todayKey = getPracticeDate(new Date());
      var day = findDay(todayKey);
      var done = day && day.done ? day.done : [];

      var meta = document.getElementById('practice-day-meta');
      if (meta) {
        meta.textContent =
          '练习日：' +
          formatDisplayDate(todayKey) +
          '（每天凌晨 5 点换日）';
      }

      var progress = document.getElementById('practice-progress');
      if (progress) {
        progress.textContent = done.length + ' / ' + IDS.length;
      }

      var streakEl = document.getElementById('practice-streak');
      if (streakEl) {
        var streak = calcStreak(todayKey, true);
        streakEl.textContent = streak > 0 ? '连续全勤 ' + streak + ' 天' : '';
      }

      document.querySelectorAll('.practice-check').forEach(function (el) {
        var id = el.getAttribute('data-id');
        var checked = done.indexOf(id) !== -1;
        el.setAttribute('aria-pressed', checked ? 'true' : 'false');
        el.classList.toggle('is-checked', checked);
      });

      var noteEl = document.getElementById('practice-today-note');
      if (noteEl) {
        var preview = notePreview(day && day.note ? day.note : '', done);
        noteEl.textContent = preview
          ? '今日备注：' + preview
          : done.length
            ? ''
            : '今天还没打卡：在「练习打卡」里加上今天的日期和训练项。';
      }

      renderHeatmap(todayKey);

      var history = document.getElementById('practice-history');
      if (!history) return;

      var list = RECORDS.slice(0, 30);
      if (list.length === 0) {
        history.innerHTML = '<p class="meta">暂无记录</p>';
        return;
      }

      history.innerHTML = list
        .map(function (rec) {
          var items = IDS.map(function (id) {
            var ok = rec.done.indexOf(id) !== -1;
            return (
              '<span class="practice-hist-item' +
              (ok ? ' is-done' : '') +
              '">' +
              id +
              (ok ? ' ✓' : '') +
              '</span>'
            );
          }).join('');
          var full =
            IDS.every(function (id) {
              return rec.done.indexOf(id) !== -1;
            })
              ? ' <span class="tag">全勤</span>'
              : '';
          var preview = notePreview(rec.note || '', rec.done || []);
          var noteHtml = preview
            ? '<p class="meta practice-hist-note">' + preview + '</p>'
            : '';
          return (
            '<div class="practice-hist-row">' +
            '<strong>' +
            formatDisplayDate(rec.date) +
            '</strong>' +
            full +
            '<div class="practice-hist-items">' +
            items +
            '</div>' +
            noteHtml +
            '</div>'
          );
        })
        .join('');
    }

    render();
  })();
</script>
